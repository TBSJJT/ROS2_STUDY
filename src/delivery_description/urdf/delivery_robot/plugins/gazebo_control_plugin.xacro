<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- 四轮差速（滑移转向）：支持前后运动和转向，不支持 linear.y 横移。 -->
    <xacro:macro name="gazebo_control_plugin">
        <gazebo>
            <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
                <ros>
                    <namespace>/</namespace>
                    <remapping>cmd_vel:=cmd_vel</remapping>
                    <remapping>odom:=odom</remapping>
                </ros>
                <!-- 插件控制更新频率，单位 Hz。 -->
                <update_rate>30</update_rate>

                <!-- 必须声明两对轮；默认是一对，与四个关节不匹配会加载失败。 -->
                <num_wheel_pairs>2</num_wheel_pairs>
                <!-- 左右关节分别按前、后顺序配对：第一对前轮，第二对后轮。 -->
                <left_joint>LeftFront_wheel_joint</left_joint>
                <left_joint>LeftBack_wheel_joint</left_joint>
                <right_joint>RightFront_wheel_joint</right_joint>
                <right_joint>RightBack_wheel_joint</right_joint>

                <!-- 下位机给出的半轮距为 0.133 m，因此左右全轮距为 0.266 m。
                     每对轮必须分别设置，第二项不能省略，否则使用插件默认值。
                     此处为左右轮距，不是前后轴距。 -->
                <wheel_separation>0.266</wheel_separation>
                <wheel_separation>0.266</wheel_separation>
                <!-- 模型圆柱半径为 0.04 m；前后两对轮的直径均为 0.08 m。 -->
                <wheel_diameter>0.08</wheel_diameter>
                <wheel_diameter>0.08</wheel_diameter>

                <!-- 最大轮轴扭矩，单位 N·m；保留原有驱动限制。 -->
                <max_wheel_torque>20.0</max_wheel_torque>
                <!-- 插件限制轮缘线速度的变化率，单位 m/s²。 -->
                <max_wheel_acceleration>1.0</max_wheel_acceleration>
                <!-- 仿真插件发布里程计及其 TF。 -->
                <publish_odom>true</publish_odom>
                <publish_odom_tf>true</publish_odom_tf>
                <!-- 四个关节各自驱动、各自反馈；同侧等速是差速运动学约束。
                     轮子 TF 统一由 robot_state_publisher 根据真实关节状态发布。 -->
                <publish_wheel_tf>false</publish_wheel_tf>
                <odometry_frame>odom</odometry_frame>
                <robot_base_frame>base_footprint</robot_base_frame>
            </plugin>
            <!-- 发布四个独立轮轴的仿真位置/速度，不能用静态零值代替反馈。 -->
            <plugin name="wheel_joint_states" filename="libgazebo_ros_joint_state_publisher.so">
                <ros><namespace>/</namespace></ros>
                <update_rate>50</update_rate>
                <joint_name>LeftFront_wheel_joint</joint_name>
                <joint_name>LeftBack_wheel_joint</joint_name>
                <joint_name>RightFront_wheel_joint</joint_name>
                <joint_name>RightBack_wheel_joint</joint_name>
            </plugin>
        </gazebo>
    </xacro:macro>
</robot>
