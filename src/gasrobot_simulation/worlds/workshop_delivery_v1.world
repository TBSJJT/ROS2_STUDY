<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.7">
  <world name="workshop_delivery_v1">
    <!-- Ground truth for experiment evaluation only; never used by AMCL or Nav2. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>20.0</update_rate>
    </plugin>
    <!-- Two rows of three machines: A/B/C at y=3, D/E/F at y=7. Six visual-only docks correspond one-to-one. Material rack at (1.5,0.45); depot/spawn at (1.5,1.5). Coordinates use world frame. -->
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.75 0.80 0.85 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
      <cast_shadows>true</cast_shadows>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>
    <gui fullscreen="0">
      <camera name="overview">
        <pose>15 -8 16 0 0.82 2.18</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
