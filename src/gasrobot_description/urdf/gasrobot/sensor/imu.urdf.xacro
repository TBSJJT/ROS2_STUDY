<?xml version="1.0"?>
<robot xmlns:xacro= "http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find gasrobot_description)/urdf/gasrobot/mass_inertia.xacro"/>

    <xacro:macro name="imu_xacro" params="xyz">
        <!-- 机器人的IMU部件 -->
        <link name="imu_link">
            <!-- 部件的外观描述 -->
            <visual>
                <!-- 沿着自己几何中心的偏移和旋转量 -->
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <!-- 几何形状 -->
                <geometry>
                    <!-- 立方体 -->
                    <box size="0.012 0.02 0.003"/>
                </geometry>
                <!-- 材质和颜色描述 -->
                <material name="black">
                    <color rgba="0.0 0.0 0.0 0.5"/>
                </material>
            </visual>
            <collision>
                <!-- 沿着自己几何中心的偏移和旋转量 -->
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <!-- 几何形状 -->
                <geometry>
                    <!-- 立方体 -->
                    <box size="0.012 0.02 0.003"/>
                </geometry>
                <!-- 材质和颜色描述 -->
                <material name="black">
                    <color rgba="0.0 0.0 0.0 0.5"/>
                </material>
            </collision>
            <!-- 0.01kg 宽度0.02m 高度0.003m 长度0.12m -->
            <xacro:box_inertia m="0.01" w="0.02" h="0.003" d="0.12"/>

        </link>

        <!-- 机器人的关节,用于组合部件 -->
        <joint name="imu_joint" type="fixed">
            <parent link="base_link"/>
            <child link="imu_link"/>
            <origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
        </joint>
    </xacro:macro>
    
</robot>