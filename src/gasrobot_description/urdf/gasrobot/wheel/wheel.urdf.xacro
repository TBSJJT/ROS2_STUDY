<?xml version="1.0"?>
<robot xmlns:xacro= "http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find gasrobot_description)/urdf/gasrobot/mass_inertia.xacro"/>


    <xacro:macro name="wheel_xacro" params="wheel_name xyz">
        <!-- 机器人的轮子部件 -->
        <link name="${wheel_name}_link">
            <!-- 部件的外观描述 -->
            <visual>
                <!-- 沿着自己几何中心的偏移和旋转量 -->
                <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/>
                <!-- 几何形状 -->
                <geometry>
                    <!-- 立方体 -->
                    <cylinder radius="0.04" length="0.04"/>
                </geometry>
                <!-- 材质和颜色描述 -->
                <material name="black">
                    <color rgba="0.0 0.0 0.0 1.0"/>
                </material>
            </visual>
            <collision>
                <!-- 沿着自己几何中心的偏移和旋转量 -->
                <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/>
                <!-- 几何形状 -->
                <geometry>
                    <!-- 立方体 -->
                    <cylinder radius="0.04" length="0.04"/>
                </geometry>
                <!-- 材质和颜色描述 -->
                <material name="black">
                    <color rgba="0.0 0.0 0.0 1.0"/>
                </material>
            </collision>
            <xacro:cylinder_inertia m="0.05" r="0.04" h="0.04"/>
        </link>

        <!-- 机器人的关节,用于组合部件 -->
        <joint name="${wheel_name}_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${wheel_name}_link"/>
            <origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>        <!-- 让轮子绕y轴转动 -->
        </joint>

        <!-- ==================== Gazebo 参数 ==================== -->
        <gazebo reference="${wheel_name}_link">

            <!-- Gazebo 中轮子显示为黑色 -->
            <material>Gazebo/Black</material>

            <!--
                四轮差速底盘转弯时，前后轮存在不可避免的横向滑移。
                fdir1 指定车轮滚动方向为车体 x 轴：该方向保留较大的驱动摩擦力；
                与其垂直的横向使用较小摩擦系数，使底盘能够原地转向。
                如果两个方向都设为 20，四个轮子会横向锁死，只能前后行驶。
            -->
            <fdir1>1.0 0.0 0.0</fdir1>
            <mu1>2.0</mu1>
            <mu2>0.05</mu2>

            <!-- 接触刚度与阻尼 -->
            <kp>10000000000.0</kp>
            <kd>1.0</kd>

        </gazebo>

    </xacro:macro>
    
</robot>
