<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find gasrobot_description)/urdf/gasrobot/mass_inertia.xacro"/>

    <!--
        四个车轮共用此宏。wheel_name 决定 link/joint 名称，必须与 ros2_control 配置一致；
        xyz 是轮轴中心相对 base_link 的位置（m），由 gas_robot.urdf.xacro 传入。
        visual 用于显示，collision 用于接触求解，inertial 用于动力学；三者需保持一致。
        修改半径时还要同步差速控制器的 wheel_radius，否则轮式里程计会产生比例误差。
    -->
    <xacro:macro name="wheel_xacro" params="wheel_name xyz">
        <!-- 机器人的轮子部件 -->
        <link name="${wheel_name}_link">
            <!-- 圆柱默认轴向是局部 Z；绕 X 旋转 pi/2 后沿轮轴 Y 放置。 -->
            <visual>
                <!-- 沿着自己几何中心的偏移和旋转量 -->
                <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/>
                <!-- 几何形状 -->
                <geometry>
                    <!-- 圆柱车轮，半径与差速控制器的 wheel_radius 保持一致。 -->
                    <cylinder radius="0.04" length="0.04"/>
                </geometry>
                <!-- 材质和颜色描述 -->
                <material name="black">
                    <color rgba="0.0 0.0 0.0 1.0"/>
                </material>
            </visual>
            <collision>
                <!-- 沿着自己几何中心的偏移和旋转量 -->
                <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/>
                <!-- 几何形状 -->
                <geometry>
                    <!-- 圆柱车轮，半径与差速控制器的 wheel_radius 保持一致。 -->
                    <cylinder radius="0.04" length="0.04"/>
                </geometry>
                <!-- 材质和颜色描述 -->
                <material name="black">
                    <color rgba="0.0 0.0 0.0 1.0"/>
                </material>
            </collision>
            <!-- 轮轴沿 link 的 Y 轴；惯量轴必须与真实旋转轴一致。 -->
            <xacro:cylinder_inertia_y m="0.05" r="0.04" h="0.04"/>
        </link>

        <!-- continuous 表示轮轴可以连续旋转；axis 在关节坐标系中定义。
             这里不改变关节原点朝向，所以其 Y 轴与 base_link 的 Y 轴一致。 -->
        <joint name="${wheel_name}_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${wheel_name}_link"/>
            <origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>        <!-- 让轮子绕y轴转动 -->
        </joint>

        <!-- ==================== Gazebo 参数 ==================== -->
        <gazebo reference="${wheel_name}_link">

            <!-- Gazebo 中轮子显示为黑色 -->
            <material>Gazebo/Black</material>

            <!--
                fdir1 属于 collision 的局部坐标系，而不是车体坐标系。
                圆柱 collision 绕 X 轴旋转了 pi/2，所以局部 Z 就是轮轴方向；
                选择轮轴可避免摩擦方向随着轮子滚动而周期性偏向地面法向。
                第一方向沿轮轴（横向）：保留少量滑移摩擦，允许四轮滑移转向。
                第二方向沿地面滚动方向：保留驱动力，限制纵向打滑。
                这些是仿真接触参数；不改变实车驱动或轮式里程计的几何尺寸。
            -->
            <fdir1>0.0 0.0 1.0</fdir1>
            <mu1>0.005</mu1>
            <mu2>2.0</mu2>

            <!-- 接触求解：kp 为刚度（N/m），kd 为阻尼（N·s/m）。
                 minDepth 是允许的接触深度（m），maxVel 限制穿透修正速度（m/s）。
                 这些数值与摩擦参数一起经本场景验证，用于减少落地/滚动时的数值抖动；
                 更改它们后应重新做转向、里程计和配送验收，不能视作真实轮胎参数。 -->
            <kp>1000000.0</kp>
            <kd>100.0</kd>
            <minDepth>0.001</minDepth>
            <maxVel>0.1</maxVel>

        </gazebo>

    </xacro:macro>
</robot>
